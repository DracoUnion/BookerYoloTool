# Keep these config/model files:
!runtime/**/*.cfg
!runtime/**/*.names
!runtime/**/*.data
!runtime/**/*.txt
!runtime/**/*.cmd
!runtime/**/*.png
!runtime/**/*.doc

# Logs
*.log

# Test artifacts
.coverage
.pytest_cache/